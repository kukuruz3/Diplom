@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "График занятости сотрудников";
    var employees = ViewBag.Employees as List<SanatoriumIS.Models.Employee>;
    var assignments = ViewBag.Assignments as List<SanatoriumIS.Models.ProcedureAssignment>;
    var selectedDate = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container-fluid px-4 mt-4">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="px-4 py-3" style="background: linear-gradient(145deg, #2d5a3b 0%, #3d6e4a 100%);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-white mb-0 fw-bold">
                        <i class="bi bi-person-workspace me-2"></i> Занятость сотрудников
                    </h2>
                    <p class="text-white-50 mb-0 mt-1">
                        Расписание работы персонала
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <input type="date" id="scheduleDate" class="form-control form-control-lg rounded-pill shadow-sm"
                           style="background: white; border: none;" value="@selectedDate" />
                    <button id="refreshBtn" class="btn btn-light rounded-pill px-4 shadow-sm">
                        <i class="bi bi-arrow-repeat me-1"></i> Показать
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            @if (employees != null && employees.Any())
            {
                <div class="table-responsive" style="max-height: 70vh; overflow-y: auto;">
                    <table class="table table-bordered table-hover schedule-table" style="min-width: 1200px;">
                        <thead class="sticky-top" style="background-color: #f8f9fc; z-index: 10;">
                            <tr>
                                <th style="width: 220px; position: sticky; left: 0; background-color: #f8f9fc; z-index: 11;">
                                    <i class="bi bi-person-badge me-1"></i> Сотрудник
                                </th>
                                <th class="text-center" style="min-width: 80px;">8:00</th>
                                <th class="text-center" style="min-width: 80px;">8:30</th>
                                <th class="text-center" style="min-width: 80px;">9:00</th>
                                <th class="text-center" style="min-width: 80px;">9:30</th>
                                <th class="text-center" style="min-width: 80px;">10:00</th>
                                <th class="text-center" style="min-width: 80px;">10:30</th>
                                <th class="text-center" style="min-width: 80px;">11:00</th>
                                <th class="text-center" style="min-width: 80px;">11:30</th>
                                <th class="text-center" style="min-width: 100px;">12:00-13:00</th>
                                <th class="text-center" style="min-width: 80px;">13:00</th>
                                <th class="text-center" style="min-width: 80px;">13:30</th>
                                <th class="text-center" style="min-width: 80px;">14:00</th>
                                <th class="text-center" style="min-width: 80px;">14:30</th>
                                <th class="text-center" style="min-width: 80px;">15:00</th>
                                <th class="text-center" style="min-width: 80px;">15:30</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var employee in employees)
                            {
                                var employeeAssignments = assignments?.Where(a => a.EmployeeId == employee.Id).ToList() ?? new List<SanatoriumIS.Models.ProcedureAssignment>();

                                <tr>
                                    <td style="position: sticky; left: 0; background-color: white; z-index: 5;" class="shadow-sm">
                                        <div class="fw-semibold">
                                            <i class="bi bi-person-badge text-success me-2"></i>
                                            @employee.FullName
                                        </div>
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-briefcase me-1"></i> @employee.Position
                                        </div>
                                        @if (employee.ProcedureRoom != null)
                                        {
                                            <div class="small mt-1">
                                                <span class="badge bg-light text-dark">
                                                    <i class="bi bi-building me-1"></i> @employee.ProcedureRoom.Name
                                                </span>
                                            </div>
                                        }
                                    </td>

                                    <!-- 8:00 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(8, 0, 0), new TimeSpan(8, 30, 0))"
                                        data-time="08:00" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(8, 0, 0), new TimeSpan(8, 30, 0), "08:00")
                                    </td>

                                    <!-- 8:30 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(8, 30, 0), new TimeSpan(9, 0, 0))"
                                        data-time="08:30" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(8, 30, 0), new TimeSpan(9, 0, 0), "08:30")
                                    </td>

                                    <!-- 9:00 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(9, 0, 0), new TimeSpan(9, 30, 0))"
                                        data-time="09:00" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(9, 0, 0), new TimeSpan(9, 30, 0), "09:00")
                                    </td>

                                    <!-- 9:30 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(9, 30, 0), new TimeSpan(10, 0, 0))"
                                        data-time="09:30" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(9, 30, 0), new TimeSpan(10, 0, 0), "09:30")
                                    </td>

                                    <!-- 10:00 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(10, 0, 0), new TimeSpan(10, 30, 0))"
                                        data-time="10:00" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(10, 0, 0), new TimeSpan(10, 30, 0), "10:00")
                                    </td>

                                    <!-- 10:30 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(10, 30, 0), new TimeSpan(11, 0, 0))"
                                        data-time="10:30" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(10, 30, 0), new TimeSpan(11, 0, 0), "10:30")
                                    </td>

                                    <!-- 11:00 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(11, 0, 0), new TimeSpan(11, 30, 0))"
                                        data-time="11:00" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(11, 0, 0), new TimeSpan(11, 30, 0), "11:00")
                                    </td>

                                    <!-- 11:30 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(11, 30, 0), new TimeSpan(12, 0, 0))"
                                        data-time="11:30" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(11, 30, 0), new TimeSpan(12, 0, 0), "11:30")
                                    </td>

                                    <!-- 12:00-13:00 Обед -->
                                    <td class="slot-cell lunch-slot" data-time="12:00" data-employee-id="@employee.Id">
                                        <div class="slot-info">
                                            <strong style="color: #e65100;">🍽️ Обед</strong>
                                            <br>
                                            <small class="text-muted">12:00 - 13:00</small>
                                        </div>
                                    </td>

                                    <!-- 13:00 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(13, 0, 0), new TimeSpan(13, 30, 0))"
                                        data-time="13:00" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(13, 0, 0), new TimeSpan(13, 30, 0), "13:00")
                                    </td>

                                    <!-- 13:30 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(13, 30, 0), new TimeSpan(14, 0, 0))"
                                        data-time="13:30" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(13, 30, 0), new TimeSpan(14, 0, 0), "13:30")
                                    </td>

                                    <!-- 14:00 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(14, 0, 0), new TimeSpan(14, 30, 0))"
                                        data-time="14:00" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(14, 0, 0), new TimeSpan(14, 30, 0), "14:00")
                                    </td>

                                    <!-- 14:30 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(14, 30, 0), new TimeSpan(15, 0, 0))"
                                        data-time="14:30" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(14, 30, 0), new TimeSpan(15, 0, 0), "14:30")
                                    </td>

                                    <!-- 15:00 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(15, 0, 0), new TimeSpan(15, 30, 0))"
                                        data-time="15:00" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(15, 0, 0), new TimeSpan(15, 30, 0), "15:00")
                                    </td>

                                    <!-- 15:30 -->
                                    <td class="slot-cell @GetSlotStatusClass(employeeAssignments, new TimeSpan(15, 30, 0), new TimeSpan(16, 0, 0))"
                                        data-time="15:30" data-employee-id="@employee.Id">
                                        @RenderSlot(employeeAssignments, new TimeSpan(15, 30, 0), new TimeSpan(16, 0, 0), "15:30")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Легенда -->
                <div class="mt-4 pt-3 border-top d-flex justify-content-center gap-4 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 20px; height: 20px; background: #e8f5e9; border: 1px solid #a5d6a7; border-radius: 4px;"></div>
                        <span>Свободен</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 20px; height: 20px; background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%); border-radius: 4px;"></div>
                        <span>Запланирована</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 20px; height: 20px; background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); border-radius: 4px;"></div>
                        <span>Выполнена</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 20px; height: 20px; background: #fff3e0; border: 2px solid #ff9800; border-radius: 4px;"></div>
                        <span>Обеденный перерыв</span>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-1 text-muted"></i>
                    <h4 class="text-muted mt-3">Нет активных сотрудников</h4>
                    <p class="text-muted">Добавьте сотрудников в систему, чтобы видеть их график работы</p>
                    <a href="/Employees/Create" class="btn rounded-pill px-4 py-2 shadow-sm mt-2"
                       style="background: linear-gradient(135deg, #2d5a3b 0%, #3d6e4a 100%); color: white;">
                        <i class="bi bi-plus-circle me-2"></i> Добавить сотрудника
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Модальное окно для управления статусом процедуры -->
<div class="modal fade" id="statusModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0" style="background: linear-gradient(135deg, #4a7c5e 0%, #5a8c6e 100%); border-radius: 20px 20px 0 0;">
                <h5 class="modal-title text-white fw-bold">
                    <i class="bi bi-calendar-check me-2"></i> Управление процедурой
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p><strong>Процедура:</strong> <span id="modalProcedureName"></span></p>
                <p><strong>Клиент:</strong> <span id="modalClientName"></span></p>
                <p><strong>Время:</strong> <span id="modalTime"></span></p>
                <p><strong>Текущий статус:</strong> <span id="modalStatus"></span></p>

                <hr />

                @if (User.IsInRole("Admin") || User.IsInRole("ExecutingDoctor"))
                {
                    <div id="statusButtons">
                        <div id="completeBtnBlock" style="display: block;">
                            <button id="completeBtn" class="btn btn-success rounded-pill px-4 me-2">
                                <i class="bi bi-check-circle me-2"></i> Отметить выполненной
                            </button>
                        </div>
                        <button id="cancelBtn" class="btn btn-danger rounded-pill px-4 mt-2">
                            <i class="bi bi-x-circle me-2"></i> Отменить
                        </button>
                    </div>

                    <div id="cancelReasonBlock" style="display: none;" class="mt-3">
                        <label class="form-label fw-semibold">Причина отмены:</label>
                        <select id="cancelReason" class="form-select">
                            <option value="">-- Выберите причину --</option>
                            <option value="Клиент отказался">Клиент отказался</option>
                            <option value="Неявка клиента">Неявка клиента</option>
                            <option value="Технические причины">Технические причины</option>
                            <option value="Отсутствие оборудования">Отсутствие оборудования</option>
                            <option value="Болезнь сотрудника">Болезнь сотрудника</option>
                            <option value="Ошибка записи">Ошибка записи</option>
                            <option value="Другое">Другое</option>
                        </select>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        Только администратор или исполняющий врач могут изменять статус процедуры.
                    </div>
                }
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-sm rounded-pill px-3" style="background-color: #f0f2f5; color: #555;" data-bs-dismiss="modal">
                    Закрыть
                </button>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetSlotStatusClass(List<SanatoriumIS.Models.ProcedureAssignment> assignments, TimeSpan start, TimeSpan end)
    {
        var booking = assignments.FirstOrDefault(a => a.StartTime < end && a.EndTime > start);
        if (booking == null) return "available";

        if (booking.Status == "Выполнена") return "completed";
        return "busy";
    }

    public IHtmlContent RenderSlot(List<SanatoriumIS.Models.ProcedureAssignment> assignments, TimeSpan start, TimeSpan end, string timeLabel)
    {
        var booking = assignments.FirstOrDefault(a => a.StartTime < end && a.EndTime > start);

        if (booking != null)
        {
            var procedureName = booking.Procedure?.Name ?? "";
            var clientName = booking.Client?.FullName ?? "";
            var shortProcedureName = procedureName.Length > 18 ? procedureName.Substring(0, 15) + "..." : procedureName;
            var shortClientName = clientName.Length > 15 ? clientName.Substring(0, 12) + "..." : clientName;

            var statusIcon = booking.Status == "Выполнена" ? "✅ " : "📅 ";

            return new HtmlString($@"
                <div class='slot-info' 
                     data-assignment-id='{booking.Id}'
                     data-procedure-name='{System.Net.WebUtility.HtmlEncode(procedureName)}'
                     data-client-name='{System.Net.WebUtility.HtmlEncode(clientName)}'
                     data-time='{timeLabel}'
                     data-status='{booking.Status}'
                     onclick='openStatusModal(this)'>
                    <div class='procedure-name'>{statusIcon}{System.Net.WebUtility.HtmlEncode(shortProcedureName)}</div>
                    <div class='client-name'>{System.Net.WebUtility.HtmlEncode(shortClientName)}</div>
                    <div class='time'>{timeLabel}</div>
                </div>
            ");
        }

        return new HtmlString($@"
            <div class='slot-info'>
                <div class='slot-time'>{timeLabel}</div>
                <small class='text-muted'>Свободен</small>
            </div>
        ");
    }
}

<style>
    .schedule-table {
        width: 100%;
        border-collapse: collapse;
    }

        .schedule-table th, .schedule-table td {
            border: 1px solid #e9ecef;
            vertical-align: middle;
            padding: 8px;
        }

        .schedule-table th {
            background-color: #f8f9fc;
            font-weight: 600;
            color: #2d5a3b;
        }

    .slot-cell {
        min-height: 65px;
        text-align: center;
        transition: all 0.2s;
        cursor: pointer;
    }

        .slot-cell.available {
            background: #e8f5e9;
        }

            .slot-cell.available:hover {
                background: #c8e6c9;
                transform: scale(1.02);
            }

        .slot-cell.busy {
            background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
        }

        .slot-cell.completed {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        }

            .slot-cell.busy:hover, .slot-cell.completed:hover {
                transform: scale(1.02);
                filter: brightness(0.98);
            }

        .slot-cell.lunch-slot {
            background: #fff3e0;
            border: 2px solid #ff9800;
            cursor: not-allowed;
        }

    .slot-info {
        font-size: 10px;
        text-align: center;
        width: 100%;
    }

        .slot-info .procedure-name {
            font-weight: 700;
            color: #c62828;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .slot-cell.completed .slot-info .procedure-name {
        color: #1565c0 !important;
    }

    .slot-info .client-name {
        font-size: 9px;
        color: #d32f2f;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .slot-cell.completed .slot-info .client-name {
        color: #1565c0;
    }

    .slot-info .time {
        font-size: 9px;
        color: #6c7d70;
    }

    .slot-time {
        font-size: 11px;
        font-weight: 600;
        color: #2d5a3b;
    }

    .table-responsive {
        max-height: 70vh;
        overflow-y: auto;
        overflow-x: auto;
    }

    .sticky-top {
        position: sticky;
        top: 0;
    }
</style>

@section Scripts {
    <script>
        let currentAssignmentId = null;
        let currentStatus = null;

        function openStatusModal(element) {
            const slotInfo = element;
            const assignmentId = slotInfo.dataset.assignmentId;
            const procedureName = slotInfo.dataset.procedureName;
            const clientName = slotInfo.dataset.clientName;
            const time = slotInfo.dataset.time;
            const status = slotInfo.dataset.status;

            if (!assignmentId) return;

            currentAssignmentId = assignmentId;
            currentStatus = status;
            $('#modalProcedureName').text(procedureName);
            $('#modalClientName').text(clientName);
            $('#modalTime').text(time);

            let statusText = '';
            if (status === 'Выполнена') {
                statusText = '<span class="text-success">✅ Выполнена</span>';
            } else if (status === 'Отменена') {
                statusText = '<span class="text-danger">❌ Отменена</span>';
            } else {
                statusText = '<span class="text-primary">📅 Запланирована</span>';
            }
            $('#modalStatus').html(statusText);

            // Если процедура уже выполнена - скрываем кнопку "Отметить выполненной"
            if (status === 'Выполнена') {
                $('#completeBtnBlock').hide();
            } else {
                $('#completeBtnBlock').show();
            }

            $('#cancelReasonBlock').hide();
            $('#cancelReason').val('');
            $('#cancelBtn').html('<i class="bi bi-x-circle me-2"></i> Отменить');

            $('#statusModal').modal('show');
        }

        $('#completeBtn').on('click', function() {
            if (!confirm('Отметить процедуру как выполненную?')) return;

            $.ajax({
                url: '/ProcedureAssignments/UpdateStatus',
                type: 'POST',
                data: { assignmentId: currentAssignmentId, status: 'Completed' },
                success: function(response) {
                    if (response.success) {
                        $('#statusModal').modal('hide');
                        location.reload();
                    } else {
                        alert('Ошибка: ' + response.message);
                    }
                },
                error: function() {
                    alert('Ошибка при изменении статуса');
                }
            });
        });

        $('#cancelBtn').on('click', function() {
            const isConfirmed = $('#cancelReasonBlock').is(':visible');

            if (!isConfirmed) {
                $('#cancelReasonBlock').show();
                $('#cancelBtn').html('<i class="bi bi-exclamation-triangle me-2"></i> Подтвердить отмену');
            } else {
                const reason = $('#cancelReason').val();
                if (!reason) {
                    alert('Укажите причину отмены');
                    return;
                }

                $.ajax({
                    url: '/ProcedureAssignments/UpdateStatus',
                    type: 'POST',
                    data: {
                        assignmentId: currentAssignmentId,
                        status: 'Cancelled',
                        cancelReason: reason
                    },
                    success: function(response) {
                        if (response.success) {
                            $('#statusModal').modal('hide');
                            location.reload();
                        } else {
                            alert('Ошибка: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('Ошибка при отмене');
                    }
                });
            }
        });

        $(document).ready(function() {
            $('#refreshBtn').on('click', function() {
                const date = $('#scheduleDate').val();
                window.location.href = '/Employees/Schedule?date=' + date;
            });
        });
    </script>
}