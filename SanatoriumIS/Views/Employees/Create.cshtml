@model SanatoriumIS.Models.Employee

@{
    ViewData["Title"] = "Добавление сотрудника";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="px-4 py-3" style="background: linear-gradient(145deg, #2d5a3b 0%, #3d6e4a 100%);">
                    <h3 class="text-white mb-0 fw-bold">
                        <i class="bi bi-person-plus me-2"></i> Добавление сотрудника
                    </h3>
                    <p class="text-white-50 mb-0 mt-1">Заполните информацию о новом сотруднике</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" id="employeeForm" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="FullName" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-person me-1 text-success"></i> ФИО <span class="text-danger">*</span>
                                </label>
                                <input asp-for="FullName" class="form-control form-control-lg rounded-3"
                                       placeholder="Иванов Иван Иванович" style="background-color: #f8f9fc;" />
                                <span asp-validation-for="FullName" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Position" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-briefcase me-1 text-success"></i> Должность <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Position" class="form-select form-select-lg rounded-3" asp-items="ViewBag.Positions" style="background-color: #f8f9fc;">
                                    <option value="">-- Выберите должность --</option>
                                </select>
                                <span asp-validation-for="Position" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Specialization" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-tag me-1 text-success"></i> Специализация
                                </label>
                                <select asp-for="Specialization" class="form-select form-select-lg rounded-3" asp-items="ViewBag.Specializations" style="background-color: #f8f9fc;">
                                    <option value="">-- Выберите специализацию --</option>
                                </select>
                                <span asp-validation-for="Specialization" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Phone" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-telephone me-1 text-success"></i> Телефон
                                </label>
                                <input asp-for="Phone" id="Phone" class="form-control form-control-lg rounded-3"
                                       placeholder="+7 (___) ___-__-__" style="background-color: #f8f9fc;" />
                                <span asp-validation-for="Phone" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Email" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-envelope me-1 text-success"></i> Email
                                </label>
                                <input asp-for="Email" class="form-control form-control-lg rounded-3"
                                       placeholder="ivanov@sanatorium.ru" type="email" style="background-color: #f8f9fc;" />
                                <span asp-validation-for="Email" class="text-danger small mt-1"></span>
                                <small class="text-muted">Используется для входа в систему</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="ProcedureRoomId" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-building me-1 text-success"></i> Основной кабинет
                                </label>
                                <select asp-for="ProcedureRoomId" class="form-select form-select-lg rounded-3" asp-items="ViewBag.ProcedureRoomId" style="background-color: #f8f9fc;">
                                    <option value="">-- Не привязан --</option>
                                </select>
                                <span asp-validation-for="ProcedureRoomId" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="HireDate" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-calendar3 me-1 text-success"></i> Дата приема <span class="text-danger">*</span>
                                </label>
                                <input asp-for="HireDate" class="form-control form-control-lg rounded-3" type="date"
                                       value="@DateTime.Now.ToString("yyyy-MM-dd")" style="background-color: #f8f9fc;" />
                                <span asp-validation-for="HireDate" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Salary" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-currency-ruble me-1 text-success"></i> Зарплата (руб)
                                </label>
                                <input asp-for="Salary" id="SalaryInput" class="form-control form-control-lg rounded-3"
                                       type="text" placeholder="50000" style="background-color: #f8f9fc;" />
                                <span asp-validation-for="Salary" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold mb-2">
                                    <i class="bi bi-check-circle me-1 text-success"></i> Статус
                                </label>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" style="width: 50px; height: 25px;" checked>
                                    <label asp-for="IsActive" class="form-check-label ms-2 fw-semibold">
                                        Активен
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Доступ в систему -->
                        <div class="row mt-3">
                            <div class="col-md-12 mb-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="HasSystemAccess" name="HasSystemAccess" value="true" style="width: 50px; height: 25px;">
                                    <label class="form-check-label fw-semibold ms-2" for="HasSystemAccess">
                                        <i class="bi bi-lock me-1 text-success"></i> Дать доступ в систему
                                    </label>
                                </div>
                                <small class="text-muted">При включении сотрудник сможет входить в систему</small>
                            </div>
                        </div>

                        <div class="row" id="systemAccessBlock" style="display: none;">
                            <div class="col-md-12 mb-4">
                                <label class="form-label fw-semibold mb-2">
                                    <i class="bi bi-shield-check me-1 text-success"></i> Роль в системе
                                </label>
                                <select asp-for="SystemRole" class="form-select form-select-lg rounded-3" asp-items="ViewBag.SystemRoles" style="background-color: #f8f9fc;">
                                    <option value="">-- Выберите роль --</option>
                                </select>
                                <span asp-validation-for="SystemRole" class="text-danger small mt-1"></span>
                                <small class="text-muted">Определяет права доступа в системе</small>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4 pt-3">
                            <button type="submit" class="btn px-4 py-2 rounded-pill shadow-sm fw-semibold"
                                    style="background: linear-gradient(135deg, #2d5a3b 0%, #3d6e4a 100%); color: white; min-width: 140px;">
                                <i class="bi bi-save me-2"></i> Сохранить
                            </button>
                            <a href="@Url.Action("Index")" class="close-tab-on-cancel btn btn-secondary rounded-pill px-4 py-2">
                                <i class="bi bi-arrow-left me-2"></i> Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script>
        $(document).ready(function() {
        $('#Phone').mask('+7 (000) 000-00-00', {
        placeholder: '+7 (___) ___-__-__',
        clearIfNotMatch: false
        });

        $('#SalaryInput').on('input', function() {
        this.value = this.value.replace(/[^0-9]/g, '');
        });

        $('#HasSystemAccess').change(function() {
        if ($(this).is(':checked')) {
        $('#systemAccessBlock').show();
        } else {
        $('#systemAccessBlock').hide();
        $('#SystemRole').val('');
        }
        });

        if ($('#HasSystemAccess').is(':checked')) {
        $('#systemAccessBlock').show();
        }
        });

        $('#employeeForm').on('submit', function() {
        var salaryInput = $('#SalaryInput');
        if (salaryInput.length) {
        salaryInput.val(salaryInput.val().replace(/\s/g, ''));
        }
        });
    </script>
}