@model SanatoriumIS.Models.ProcedureRoom

@{
    ViewData["Title"] = "Детали кабинета";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="px-4 py-3" style="background: linear-gradient(145deg, #7cb19d 0%, #6b9e8a 100%);">
                    <h3 class="text-white mb-0 fw-bold">
                        <i class="bi bi-building me-2"></i> Детали кабинета
                    </h3>
                    <p class="text-white-50 mb-0 mt-1">Информация о процедурном кабинете</p>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-hospital" style="font-size: 64px; color: #4a7c5e;"></i>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-hash me-2 text-success"></i> Номер кабинета
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">№ @Model.RoomNumber</dd>

                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-tag me-2 text-success"></i> Название
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">@Model.Name</dd>

                        @if (!string.IsNullOrEmpty(Model.RoomType))
                        {
                            <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                                <i class="bi bi-building me-2 text-primary"></i> Тип кабинета
                            </dt>
                            <dd class="col-sm-8 p-3 mb-2">
                                <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill fs-6">
                                    <i class="bi bi-tag me-1"></i> @Model.RoomType
                                </span>
                            </dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                                <i class="bi bi-chat-text me-2 text-secondary"></i> Описание
                            </dt>
                            <dd class="col-sm-8 p-3 mb-2">@Model.Description</dd>
                        }
                    </dl>

                    <div class="d-flex justify-content-center gap-3 mt-4 pt-3" style="border-top: 1px solid #d9e5dc;">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn px-4 py-2 rounded-pill shadow-sm fw-semibold"
                           style="background: linear-gradient(135deg, #4a9e6b 0%, #3d8a5c 100%); color: white;">
                            <i class="bi bi-pencil me-2"></i> Редактировать
                        </a>
                        <a href="@Url.Action("Index")" class="close-tab-on-cancel btn btn-outline-secondary rounded-pill px-4 py-2">
                            <i class="bi bi-arrow-left me-2"></i> Назад к списку
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>