@model SanatoriumIS.ViewModels.RoomOccupancyReportViewModel

@{
    ViewData["Title"] = "Отчет по занятости номеров";
}

<style media="print">
    @@page {
        size: landscape;
        margin: 1cm;
    }
</style>

<div class="container-fluid px-4 mt-4">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <!-- Заголовок -->
        <div class="px-4 py-3" style="background: linear-gradient(145deg, #2d5a3b 0%, #3d6e4a 100%);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-white mb-0 fw-bold">
                        <i class="bi bi-door-closed me-2"></i> Отчет по занятости номеров
                    </h2>
                    <p class="text-white-50 mb-0 mt-1">
                        Текущая занятость гостиничных номеров
                    </p>
                </div>
                <button onclick="window.print()" class="btn btn-light rounded-pill px-4 shadow-sm">
                    <i class="bi bi-printer me-2"></i> Печать
                </button>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- Форма фильтрации -->
            <form method="get" action="/Rooms/OccupancyReport" class="row g-3 mb-4">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-dark">
                        <i class="bi bi-calendar3 me-2 text-success"></i> Дата
                    </label>
                    <input type="date" name="date" class="form-control form-control-lg rounded-3 shadow-sm border-0 bg-light"
                           value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-dark">
                        <i class="bi bi-funnel me-2 text-success"></i> Фильтр
                    </label>
                    <select name="showOnlyOccupied" class="form-select form-select-lg rounded-3 shadow-sm border-0 bg-light">
                        <option value="false" selected="@(!Model.ShowOnlyOccupied)">Все номера</option>
                        <option value="true" selected="@(Model.ShowOnlyOccupied)">Только занятые</option>
                    </select>
                </div>

                <div class="col-md-6 d-flex align-items-end">
                    <button type="submit" class="btn btn-lg rounded-pill w-100 shadow-sm fw-semibold"
                            style="background: linear-gradient(135deg, #2d5a3b 0%, #3d6e4a 100%); color: white;">
                        <i class="bi bi-arrow-repeat me-2"></i> Показать отчет
                    </button>
                </div>
            </form>

            <!-- Статистика -->
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="stat-card text-center p-3 rounded-4">
                        <div class="stat-icon mb-2">
                            <i class="bi bi-door-closed fs-1 text-primary"></i>
                        </div>
                        <div class="stat-value display-6 fw-bold text-primary">@Model.ReportItems.Count</div>
                        <div class="stat-label text-muted">Показано номеров</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card text-center p-3 rounded-4">
                        <div class="stat-icon mb-2">
                            <i class="bi bi-person-fill fs-1 text-danger"></i>
                        </div>
                        <div class="stat-value display-6 fw-bold text-danger">@Model.ReportItems.Count(r => r.IsOccupied)</div>
                        <div class="stat-label text-muted">Занято номеров</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card text-center p-3 rounded-4">
                        <div class="stat-icon mb-2">
                            <i class="bi bi-check-circle-fill fs-1 text-success"></i>
                        </div>
                        <div class="stat-value display-6 fw-bold text-success">@Model.ReportItems.Count(r => !r.IsOccupied)</div>
                        <div class="stat-label text-muted">Свободно номеров</div>
                    </div>
                </div>
            </div>

            <!-- Таблица отчета -->
            @if (Model.ReportItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="reportTable">
                        <thead style="background-color: #f8f9fc; border-bottom: 2px solid #e9ecef;">
                            <tr>
                                <th class="ps-4 py-3 fw-semibold" style="color: #2d5a3b;">№ номера</th>
                                <th class="py-3 fw-semibold" style="color: #2d5a3b;">Категория</th>
                                <th class="py-3 fw-semibold" style="color: #2d5a3b;">Вместимость</th>
                                <th class="py-3 fw-semibold" style="color: #2d5a3b;">Статус</th>
                                <th class="py-3 fw-semibold" style="color: #2d5a3b;">Проживающие</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ReportItems)
                            {
                                <tr style="border-bottom: 1px solid #f0f2f5;">
                                    <td class="ps-4 py-3 fw-medium">
                                        <i class="bi bi-door-closed text-primary me-2"></i> № @item.RoomNumber
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill">
                                            <i class="bi bi-star me-1"></i> @item.RoomCategory
                                        </span>
                                    </td>
                                    <td class="py-3">
                                        @if (item.Capacity == 1)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill">
                                                <i class="bi bi-person me-1"></i> 1 место
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill">
                                                <i class="bi bi-people me-1"></i> 2 места
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-@item.StatusBadge bg-opacity-10 text-@item.StatusBadge px-3 py-2 rounded-pill">
                                            <i class="bi bi-@(item.IsOccupied ? "person-fill" : "check-circle") me-1"></i> @item.Status
                                        </span>
                                    </td>
                                    <td class="py-3">
                                        @if (item.CurrentGuests.Any())
                                        {
                                            foreach (var guest in item.CurrentGuests)
                                            {
                                                <div class="mb-1">
                                                    <i class="bi bi-person-circle text-success me-2"></i>
                                                    <strong>@guest.ClientName</strong>
                                                    <br>
                                                    <small class="text-muted ms-4">
                                                        <i class="bi bi-calendar me-1"></i> @guest.CheckIn.ToString("dd.MM") → @guest.CheckOut.ToString("dd.MM")
                                                    </small>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <i class="bi bi-door-open me-1"></i> Свободен
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 my-5">
                    <div class="display-1 text-muted">
                        <i class="bi bi-door-closed"></i>
                    </div>
                    <h3 class="text-muted mt-3">
                        @if (Model.ShowOnlyOccupied)
                        {
                            <span>Нет занятых номеров</span>
                        }
                        else
                        {
                            <span>Нет номеров</span>
                        }
                    </h3>
                    <p class="text-muted mb-4">
                        @if (Model.ShowOnlyOccupied)
                        {
                            <span>На выбранную дату нет занятых номеров</span>
                        }
                        else
                        {
                            <span>В системе нет гостиничных номеров</span>
                        }
                    </p>
                </div>
            }
        </div>
    </div>
</div>

<style media="print">
    /* Скрываем всё, что не нужно при печати */
    .navbar,
    footer,
    .btn,
    .stat-card,
    form,
    .tabs-container,
    .tabs-header,
    .tab-item,
    .tab-link,
    .tab-close,
    #tabsContainer,
    .no-print,
    button,
    .dropdown,
    .nav-item,
    .navbar-nav,
    .container-fluid > .navbar,
    nav.navbar,
    .dashboard-container .btn,
    .hero-section .btn,
    .quick-card,
    .activity-card .btn,
    .metrics-grid .btn,
    [onclick] {
        display: none !important;
    }

    /* Скрываем ссылки (URL) которые появляются внизу при печати */
    a[href]:after {
        content: none !important;
        display: none !important;
    }

    a {
        text-decoration: none !important;
        color: black !important;
    }

    /* Настройки страницы */
    @@page {
        size: landscape;
        margin: 0.5cm;
    }

    /* Основные стили для печати */
    body {
        background: white;
        padding: 0;
        margin: 0;
        width: 100%;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .card {
        box-shadow: none !important;
        border: none !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
    }

    .card-body {
        padding: 0 !important;
    }

    .container-fluid {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
    }

    .table-responsive {
        overflow: visible !important;
        width: 100% !important;
    }

    .table {
        width: 100% !important;
        font-size: 9pt !important;
        border-collapse: collapse !important;
        table-layout: fixed !important;
    }

    .table th, 
    .table td {
        border: 1px solid #ddd !important;
        padding: 4px !important;
        word-wrap: break-word !important;
    }

    .badge {
        border: none !important;
        background: transparent !important;
        color: black !important;
        padding: 0 !important;
    }

    .bi {
        display: none !important;
    }

    h2, h3 {
        margin-top: 0 !important;
    }
</style>

<script>
    $(document).ready(function() {
        // При изменении фильтра автоматически отправлять форму
        $('#showOnlyOccupied').on('change', function() {
            $(this).closest('form').submit();
        });
    });
</script>