@model IEnumerable<SanatoriumIS.Models.Room>
@using Microsoft.EntityFrameworkCore
@inject SanatoriumIS.Data.ApplicationDbContext _context

@{
    ViewData["Title"] = "Номера";
}

<div class="container-fluid px-4 mt-4">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="px-4 py-3" style="background: linear-gradient(145deg, #2d5a3b 0%, #3d6e4a 100%);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="text-white mb-0 fw-bold">
                        <i class="bi bi-door-closed me-2"></i> Гостиничные номера
                    </h2>
                    <p class="text-white-50 mb-0 mt-1">Управление гостиничными номерами</p>
                </div>
                <div class="d-flex gap-2">
                    <button id="refreshStatusBtn" class="btn btn-light rounded-pill px-4 py-2 fw-semibold shadow-sm" style="color: #2d5a3b;">
                        <i class="bi bi-arrow-repeat me-2"></i> Обновить статус
                    </button>
                    <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 fw-semibold shadow-sm" style="color: #2d5a3b;">
                        <i class="bi bi-plus-circle me-2"></i> Добавить номер
                    </a>
                </div>
            </div>
        </div>
        <div class="p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #f8f9fc; border-bottom: 2px solid #e9ecef;">
                            <tr>
                                <th class="ps-4 py-3 fw-semibold" style="color: #2d5a3b;">Номер</th>
                                <th class="py-3 fw-semibold" style="color: #2d5a3b;">Тип</th>
                                <th class="py-3 fw-semibold" style="color: #2d5a3b;">Категория</th>
                                <th class="py-3 fw-semibold" style="color: #2d5a3b;">Цена за ночь</th>
                                <th class="py-3 fw-semibold" style="color: #2d5a3b;">Статус</th>
                                <th class="pe-4 py-3 text-center fw-semibold" style="color: #2d5a3b; width: 280px;">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var roomPrice = await _context.RoomPrices
                                    .FirstOrDefaultAsync(p => p.Capacity == item.Capacity && p.Category == item.Category);

                                <tr style="border-bottom: 1px solid #f0f2f5;">
                                    <td class="ps-4 py-3 fw-medium">
                                        <i class="bi bi-door-closed text-success me-2"></i> № @item.Number
                                    </td>
                                    <td class="py-3">
                                        @if (item.Capacity == 1)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill">
                                                <i class="bi bi-person me-1"></i> Одноместный
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill">
                                                <i class="bi bi-people me-1"></i> Двухместный
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                            <i class="bi bi-star me-1"></i> @item.Category
                                        </span>
                                    </td>
                                    <td class="py-3">
                                        @if (roomPrice != null)
                                        {
                                            <span class="fw-bold text-success">
                                                <i class="bi bi-currency-ruble me-1"></i> @roomPrice.PricePerNight.ToString("N0") ₽
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">
                                                <i class="bi bi-exclamation-triangle me-1"></i> Цена не установлена
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        @if (item.IsOccupied)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">
                                                <i class="bi bi-person-fill me-1"></i> Занят
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i> Свободен
                                            </span>
                                        }
                                    </td>
                                    <td class="pe-4 py-3 text-center">
                                        <div class="d-flex gap-2 justify-content-center">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm px-3 py-1.5 rounded-pill shadow-sm"
                                               style="background: linear-gradient(135deg, #4a9e6b 0%, #3d8a5c 100%); color: white; border: none;">
                                                <i class="bi bi-pencil me-1"></i> Изменить
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm px-3 py-1.5 rounded-pill shadow-sm"
                                               style="background: linear-gradient(135deg, #7cb19d 0%, #6b9e8a 100%); color: white; border: none;">
                                                <i class="bi bi-eye me-1"></i> Детали
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm px-3 py-1.5 rounded-pill shadow-sm"
                                               style="background: linear-gradient(135deg, #c43333 0%, #a33333 100%); color: white; border: none;">
                                                <i class="bi bi-trash me-1"></i> Удалить
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 my-5">
                    <div class="display-1 text-muted">
                        <i class="bi bi-door-closed"></i>
                    </div>
                    <h3 class="text-muted mt-3">Нет гостиничных номеров</h3>
                    <p class="text-muted mb-4">Добавьте первый номер в систему</p>
                    <a asp-action="Create" class="btn rounded-pill px-4 py-2 shadow-sm" style="background: linear-gradient(135deg, #2d5a3b 0%, #3d6e4a 100%); color: white;">
                        <i class="bi bi-plus-circle me-2"></i> Добавить номер
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .btn-sm {
        transition: all 0.2s ease;
        font-size: 13px;
        font-weight: 500;
    }

        .btn-sm:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
        }

    .table tbody tr:hover {
        background-color: #f8f9fc;
        transition: all 0.2s;
    }
</style>

@section Scripts {
    <script>
        $('#refreshStatusBtn').on('click', function() {
            const btn = $(this);
            const originalText = btn.html();
            btn.html('<i class="bi bi-hourglass-split me-2"></i> Обновление...').prop('disabled', true);

            $.ajax({
                url: '/Rooms/RefreshOccupancyStatus',
                type: 'POST',
                success: function(response) {
                    if (response.success) {
                        alert('Статус номеров успешно обновлён!');
                        location.reload();
                    } else {
                        alert('Ошибка: ' + response.message);
                    }
                },
                error: function() {
                    alert('Ошибка при обновлении статуса');
                },
                complete: function() {
                    btn.html(originalText).prop('disabled', false);
                }
            });
        });
    </script>
}