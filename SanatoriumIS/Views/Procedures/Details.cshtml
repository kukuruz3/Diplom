@model SanatoriumIS.Models.Procedure

@{
    ViewData["Title"] = "Детали процедуры";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="px-4 py-3" style="background: linear-gradient(145deg, #7cb19d 0%, #6b9e8a 100%);">
                    <h3 class="text-white mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2"></i> Детали процедуры
                    </h3>
                    <p class="text-white-50 mb-0 mt-1">Информация о медицинской процедуре</p>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-heart-pulse" style="font-size: 64px; color: #4a7c5e;"></i>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-tag me-2 text-success"></i> Название процедуры
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">@Model.Name</dd>

                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-hourglass-split me-2 text-info"></i> Длительность
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">@Model.DurationMinutes минут</dd>

                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-currency-ruble me-2 text-success"></i> Стоимость
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">
                            <span class="fw-bold fs-4 text-success">@Model.Price.ToString("N0") ₽</span>
                        </dd>

                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-collection me-2 text-primary"></i> Тип процедуры
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">
                            @if (!string.IsNullOrEmpty(Model.ProcedureType))
                            {
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fs-6">
                                    @Model.ProcedureType
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Не указан</span>
                            }
                        </dd>

                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-building me-2 text-warning"></i> Требуемый тип кабинета
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">
                            @if (!string.IsNullOrEmpty(Model.RequiredRoomType))
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill fs-6">
                                    @Model.RequiredRoomType
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark px-3 py-2 rounded-pill">
                                    <i class="bi bi-check-circle me-1"></i> Любой кабинет
                                </span>
                            }
                        </dd>
                    </dl>

                    <div class="d-flex justify-content-center gap-3 mt-4 pt-3" style="border-top: 1px solid #d9e5dc;">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn px-4 py-2 rounded-pill shadow-sm fw-semibold"
                           style="background: linear-gradient(135deg, #4a9e6b 0%, #3d8a5c 100%); color: white;">
                            <i class="bi bi-pencil me-2"></i> Редактировать
                        </a>
                        <a href="@Url.Action("Index")" class="close-tab-on-cancel btn btn-outline-secondary rounded-pill px-4 py-2">
                            <i class="bi bi-arrow-left me-2"></i> Назад к списку
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>