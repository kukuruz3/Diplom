@model SanatoriumIS.Models.Procedure

@{
    ViewData["Title"] = "Редактирование процедуры";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="px-4 py-3" style="background: linear-gradient(145deg, #4a7c5e 0%, #5a8c6e 100%);">
                    <h3 class="text-white mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i> Редактирование процедуры
                    </h3>
                    <p class="text-white-50 mb-0 mt-1">Измените информацию о медицинской процедуре</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="Name" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-heart-pulse me-1 text-success"></i> Название процедуры <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Name" class="form-control form-control-lg rounded-3" style="background-color: #f8f9fc;" />
                                <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="DurationMinutes" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-hourglass-split me-1 text-success"></i> Длительность <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DurationMinutes" class="form-control form-control-lg rounded-3"
                                       type="number" min="5" max="480" style="background-color: #f8f9fc;" />
                                <span asp-validation-for="DurationMinutes" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Price" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-currency-ruble me-1 text-success"></i> Стоимость <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Price" class="form-control form-control-lg rounded-3"
                                       type="number" step="0.01" style="background-color: #f8f9fc;" />
                                <span asp-validation-for="Price" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="ProcedureType" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-tag me-1 text-success"></i> Тип процедуры
                                </label>
                                <select asp-for="ProcedureType" class="form-select form-select-lg rounded-3" style="background-color: #f8f9fc;">
                                    <option value="">-- Выберите тип процедуры --</option>
                                    <option value="Массажная">Массажная</option>
                                    <option value="Физиотерапевтическая">Физиотерапевтическая</option>
                                    <option value="Диагностическая">Диагностическая</option>
                                    <option value="Лечебная">Лечебная</option>
                                    <option value="Реабилитационная">Реабилитационная</option>
                                    <option value="Гидротерапия">Гидротерапия</option>
                                    <option value="Психотерапия">Психотерапия</option>
                                    <option value="Стоматологическая">Стоматологическая</option>
                                </select>
                                <span asp-validation-for="ProcedureType" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="RequiredRoomType" class="form-label fw-semibold mb-2">
                                    <i class="bi bi-building me-1 text-success"></i> Требуемый тип кабинета <span class="text-danger">*</span>
                                </label>
                                <select asp-for="RequiredRoomType" class="form-select form-select-lg rounded-3" style="background-color: #f8f9fc;">
                                    <option value="Массажный">Массажный</option>
                                    <option value="Физиотерапевтический">Физиотерапевтический</option>
                                    <option value="ЛФК">ЛФК</option>
                                    <option value="Гидротерапия">Гидротерапия</option>
                                    <option value="Психотерапия">Психотерапия</option>
                                    <option value="Диагностический">Диагностический</option>
                                    <option value="Лечебный">Лечебный</option>
                                    <option value="Стоматологический">Стоматологический</option>
                                    <option value="Универсальный">Универсальный</option>
                                </select>
                                <span asp-validation-for="RequiredRoomType" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4 pt-3">
                            <button type="submit" class="btn px-4 py-2 rounded-pill shadow-sm fw-semibold"
                                    style="background: linear-gradient(135deg, #4a7c5e 0%, #5a8c6e 100%); color: white; min-width: 140px;">
                                <i class="bi bi-save me-2"></i> Сохранить
                            </button>
                            <a href="@Url.Action("Index")" class="close-tab-on-cancel btn btn-secondary rounded-pill px-4 py-2">
                                <i class="bi bi-arrow-left me-2"></i> Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}