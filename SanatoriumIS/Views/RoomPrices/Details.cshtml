@model SanatoriumIS.Models.RoomPrice

@{
    ViewData["Title"] = "Детали цены";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="px-4 py-3" style="background: linear-gradient(145deg, #7cb19d 0%, #6b9e8a 100%);">
                    <h3 class="text-white mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2"></i> Детали цены
                    </h3>
                    <p class="text-white-50 mb-0 mt-1">Информация о цене номера</p>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-cash-stack" style="font-size: 64px; color: #4a7c5e;"></i>
                    </div>
                    
                    <dl class="row">
                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-people me-2 text-success"></i> Вместимость
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">
                            @if (Model.Capacity == 1)
                            {
                                <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill">
                                    <i class="bi bi-person me-1"></i> 1 место (одноместный)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill">
                                    <i class="bi bi-people me-1"></i> 2 места (двухместный)
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-star me-2 text-warning"></i> Категория
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">
                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fs-6">
                                <i class="bi bi-star-fill me-1"></i> @Model.Category
                            </span>
                        </dd>

                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-currency-ruble me-2 text-success"></i> Цена за ночь
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">
                            <span class="fw-bold fs-2 text-success">
                                @Model.PricePerNight.ToString("N0") ₽
                            </span>
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                                <i class="bi bi-chat-text me-2 text-secondary"></i> Описание
                            </dt>
                            <dd class="col-sm-8 p-3 mb-2">
                                <div class="p-2 bg-light rounded-3">
                                    <i class="bi bi-info-circle me-1 text-info"></i> @Model.Description
                                </div>
                            </dd>
                        }
                    </dl>

                    <div class="alert alert-info rounded-3 mt-3">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Примечание:</strong> Эта цена автоматически подставляется при создании или редактировании номера 
                        с категорией <strong>@Model.Category</strong> и вместимостью <strong>@(Model.Capacity == 1 ? "одноместный" : "двухместный")</strong>.
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-4 pt-3" style="border-top: 1px solid #d9e5dc;">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn px-4 py-2 rounded-pill shadow-sm fw-semibold"
                           style="background: linear-gradient(135deg, #4a9e6b 0%, #3d8a5c 100%); color: white;">
                            <i class="bi bi-pencil me-2"></i> Редактировать
                        </a>
                        <a href="@Url.Action("Index")" class="close-tab-on-cancel btn btn-outline-secondary rounded-pill px-4 py-2">
                            <i class="bi bi-arrow-left me-2"></i> Назад к списку
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .badge {
        font-weight: 500;
    }
    dt i {
        width: 24px;
        display: inline-block;
    }
    .alert-info {
        background-color: #e8f5e9;
        border-color: #c8e6c9;
        color: #2d5a3b;
    }
</style>