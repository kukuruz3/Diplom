@model IEnumerable<SanatoriumIS.Models.Booking>

@{
    ViewData["Title"] = "Бронирования";
}

<div class="container-fluid px-4 mt-4">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="px-4 py-3" style="background: linear-gradient(145deg, #2d5a3b 0%, #3d6e4a 100%);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-white mb-0 fw-bold">
                        <i class="bi bi-calendar-check me-2"></i> Бронирования
                    </h2>
                    <p class="text-white-50 mb-0 mt-1">Управление бронированиями номеров</p>
                </div>
                <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 fw-semibold shadow-sm" style="color: #2d5a3b;">
                    <i class="bi bi-plus-circle me-2"></i> Новое бронирование
                </a>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- Поиск -->
            <div class="row mb-4">
                <div class="col-md-6 mx-auto">
                    <form method="get" asp-action="Index" class="d-flex gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-0 rounded-3">
                                <i class="bi bi-search text-success"></i>
                            </span>
                            <input type="text" name="searchString" class="form-control form-control-lg rounded-3 shadow-sm border-0 bg-light"
                                   placeholder="Поиск по клиенту или номеру..." value="@ViewBag.CurrentSearch" />
                            <button type="submit" class="btn btn-success rounded-3 px-4">
                                <i class="bi bi-search me-1"></i> Найти
                            </button>
                        </div>
                    </form>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                    {
                        <div class="text-center mt-2">
                            <small class="text-muted">
                                Результаты поиска: "@ViewBag.CurrentSearch"
                                <a asp-action="Index" class="text-success ms-2">Сбросить</a>
                            </small>
                        </div>
                    }
                </div>
            </div>

            <div class="p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8f9fc; border-bottom: 2px solid #e9ecef;">
                                <tr>
                                    <th class="ps-4 py-3 fw-semibold" style="color: #2d5a3b;">Клиенты</th>
                                    <th class="py-3 fw-semibold" style="color: #2d5a3b;">Номер</th>
                                    <th class="py-3 fw-semibold" style="color: #2d5a3b;">Заезд</th>
                                    <th class="py-3 fw-semibold" style="color: #2d5a3b;">Выезд</th>
                                    <th class="py-3 fw-semibold" style="color: #2d5a3b;">Дней</th>
                                    <th class="pe-4 py-3 text-center fw-semibold" style="color: #2d5a3b; width: 280px;">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var days = (item.CheckOut - item.CheckIn).Days;
                                    <tr style="border-bottom: 1px solid #f0f2f5;">
                                        <td class="ps-4 py-3">
                                            <div>
                                                <i class="bi bi-person-circle text-success me-2"></i>
                                                <strong>@item.Client?.FullName</strong>
                                                @if (item.SecondClientId.HasValue && item.SecondClient != null)
                                                {
                                                    <div class="mt-1">
                                                        <i class="bi bi-person-circle text-info me-2"></i>
                                                        <span class="text-muted">@item.SecondClient?.FullName</span>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <span class="badge bg-light text-dark px-3 py-2 rounded-pill">
                                                <i class="bi bi-door-closed me-1 text-primary"></i>
                                                № @item.Room?.Number
                                                <span class="text-muted ms-1">
                                                    (@(item.Room?.Capacity == 1 ? "одноместный" : "двухместный"))
                                                </span>
                                            </span>
                                        </td>
                                        <td class="py-3">
                                            <i class="bi bi-calendar-plus me-1 text-success"></i> @item.CheckIn.ToShortDateString()
                                        </td>
                                        <td class="py-3">
                                            <i class="bi bi-calendar-minus me-1 text-danger"></i> @item.CheckOut.ToShortDateString()
                                        </td>
                                        <td class="py-3">
                                            <span class="fw-bold text-success">@days</span>
                                        </td>
                                        <td class="pe-4 py-3 text-center">
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm px-3 py-1.5 rounded-pill shadow-sm"
                                                   style="background: linear-gradient(135deg, #7cb19d 0%, #6b9e8a 100%); color: white; border: none;">
                                                    <i class="bi bi-eye me-1"></i> Детали
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm px-3 py-1.5 rounded-pill shadow-sm"
                                                   style="background: linear-gradient(135deg, #c43333 0%, #a33333 100%); color: white; border: none;">
                                                    <i class="bi bi-trash me-1"></i> Удалить
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Информация о количестве записей -->
                    <div class="mt-3 text-center">
                        <small class="text-muted">
                            Найдено записей: @Model.Count()
                        </small>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 my-5">
                        <div class="display-1 text-muted">
                            <i class="bi bi-calendar-x"></i>
                        </div>
                        <h3 class="text-muted mt-3">
                            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                            {
                                <span>Ничего не найдено</span>
                            }
                            else
                            {
                                <span>Нет бронирований</span>
                            }
                        </h3>
                        <p class="text-muted mb-4">
                            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                            {
                                <span>По вашему запросу "@ViewBag.CurrentSearch" ничего не найдено</span>
                            }
                            else
                            {
                                <span>Создайте первое бронирование в системе</span>
                            }
                        </p>
                        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                        {
                            <a asp-action="Index" class="btn rounded-pill px-4 py-2 shadow-sm"
                               style="background: linear-gradient(135deg, #2d5a3b 0%, #3d6e4a 100%); color: white;">
                                <i class="bi bi-arrow-left me-2"></i> Показать все
                            </a>
                        }
                        else
                        {
                            <a asp-action="Create" class="btn rounded-pill px-4 py-2 shadow-sm"
                               style="background: linear-gradient(135deg, #2d5a3b 0%, #3d6e4a 100%); color: white;">
                                <i class="bi bi-plus-circle me-2"></i> Создать бронирование
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .btn-sm {
        transition: all 0.2s ease;
        font-size: 13px;
        font-weight: 500;
    }

        .btn-sm:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
        }

    .table tbody tr:hover {
        background-color: #f8f9fc;
        transition: all 0.2s;
    }

    /* Анимация для поиска */
    .input-group input {
        transition: all 0.2s;
    }

        .input-group input:focus {
            box-shadow: 0 0 0 3px rgba(45, 90, 59, 0.1);
        }
</style>