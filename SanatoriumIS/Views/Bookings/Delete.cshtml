@model SanatoriumIS.Models.Booking

@{
    ViewData["Title"] = "Удаление бронирования";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="px-4 py-3" style="background: linear-gradient(145deg, #e8b5ab 0%, #d6a094 100%);">
                    <h3 class="text-white mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Удаление бронирования
                    </h3>
                    <p class="text-white-50 mb-0 mt-1">Внимание! Это действие нельзя отменить</p>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning rounded-3 mb-4" style="background-color: #fef5e7; border-color: #fce4b4;">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Подтверждение удаления:</strong> Вы действительно хотите удалить это бронирование?
                    </div>

                    <div class="text-center mb-4">
                        <i class="bi bi-calendar-x" style="font-size: 64px; color: #d6a094;"></i>
                    </div>

                    <dl class="row">
                        <!-- Первый клиент -->
                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-person me-2 text-danger"></i> Первый клиент
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">
                            <i class="bi bi-person-circle me-2"></i>
                            <strong>@Model.Client?.FullName</strong>
                        </dd>

                        <!-- Второй клиент (если есть) -->
                        @if (Model.SecondClientId.HasValue && Model.SecondClient != null)
                        {
                            <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                                <i class="bi bi-person me-2 text-danger"></i> Второй клиент
                            </dt>
                            <dd class="col-sm-8 p-3 mb-2">
                                <i class="bi bi-person-circle me-2"></i>
                                <strong>@Model.SecondClient?.FullName</strong>
                            </dd>
                        }

                        <!-- Номер -->
                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-door-closed me-2 text-danger"></i> Номер
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">
                            <i class="bi bi-door-closed me-2"></i>
                            № @Model.Room?.Number
                            <span class="text-muted ms-1">
                                (@(Model.Room?.Capacity == 1 ? "одноместный" : "двухместный"))
                            </span>
                            <br />
                            <small class="text-muted">
                                <i class="bi bi-star me-1"></i> Категория: @Model.Room?.Category
                            </small>
                        </dd>

                        <!-- Период бронирования -->
                        <dt class="col-sm-4 bg-light p-3 rounded mb-2 fw-semibold">
                            <i class="bi bi-calendar me-2 text-danger"></i> Период бронирования
                        </dt>
                        <dd class="col-sm-8 p-3 mb-2">
                            <i class="bi bi-calendar-plus me-1 text-success"></i>
                            @Model.CheckIn.ToShortDateString()
                            <i class="bi bi-arrow-right mx-1"></i>
                            <i class="bi bi-calendar-minus me-1 text-danger"></i>
                            @Model.CheckOut.ToShortDateString()
                            <br />
                            <span class="fw-bold text-success">
                                Количество дней: @((Model.CheckOut - Model.CheckIn).Days)
                            </span>
                        </dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-3 mt-4 pt-3" style="border-top: 1px solid #d9e5dc;">
                            <button type="submit" class="btn px-4 py-2 rounded-pill shadow-sm fw-semibold"
                                    style="background: linear-gradient(135deg, #c43333 0%, #a33333 100%); color: white;">
                                <i class="bi bi-trash me-2"></i> Да, удалить
                            </button>
                            <a href="@Url.Action("Index")" class="close-tab-on-cancel btn btn-secondary rounded-pill px-4 py-2">
                                <i class="bi bi-arrow-left me-2"></i> Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>