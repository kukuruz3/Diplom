@model List<SanatoriumIS.ViewModels.CancelledProcedureViewModel>
@{
    ViewData["Title"] = "Отменённые процедуры";
    var totalCancelled = ViewBag.TotalCancelled;
    var byEmployeeStats = ViewBag.ByEmployeeStats as List<dynamic> ?? new List<dynamic>();
}

<div class="container-fluid px-4 mt-4">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="px-4 py-3" style="background: linear-gradient(145deg, #2d5a3b 0%, #3d6e4a 100%);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-white mb-0 fw-bold">
                        <i class="bi bi-x-circle-fill me-2"></i> Отменённые процедуры
                    </h2>
                    <p class="text-white-50 mb-0 mt-1">Список отменённых процедур и причины отмены</p>
                </div>
                <form method="get" class="d-flex gap-2">
                    <input type="date" name="dateFrom" class="form-control rounded-pill" value="@ViewBag.DateFrom" style="width: 150px;">
                    <span class="align-self-center">—</span>
                    <input type="date" name="dateTo" class="form-control rounded-pill" value="@ViewBag.DateTo" style="width: 150px;">
                    <button type="submit" class="btn btn-light rounded-pill px-4">Показать</button>
                </form>
            </div>
        </div>
        <div class="card-body p-4">
            @if (Model.Any())
            {
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="stat-card p-3 rounded-4 h-100">
                            <div class="fw-bold mb-3"><i class="bi bi-person-badge me-2"></i> Кто отменял:</div>
                            @if (byEmployeeStats.Any())
                            {
                                foreach (var stat in byEmployeeStats)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span>@stat.EmployeeName</span>
                                        <span class="badge bg-warning">@stat.Count</span>
                                    </div>
                                    <div class="progress mb-2" style="height: 5px;">
                                        <div class="progress-bar bg-warning" style="width: @((double)stat.Count / totalCancelled * 100)%"></div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">Нет данных</p>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="stat-card text-center p-3 rounded-4 h-100">
                            <div class="display-4 fw-bold text-danger">@totalCancelled</div>
                            <div class="text-muted">всего отмен</div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th>Клиент</th>
                                <th>Процедура</th>
                                <th>Сотрудник</th>
                                <th>Планируемая дата</th>
                                <th>Время</th>
                                <th>Дата отмены</th>
                                <th>Кто отменил</th>
                                <th>Причина отмены</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-medium">@item.ClientName</td>
                                    <td>@item.ProcedureName</td>
                                    <td>@item.EmployeeName</td>
                                    <td>@item.OriginalDate.ToString("dd.MM.yyyy")</td>
                                    <td>@item.OriginalTime.ToString(@"hh\:mm")</td>
                                    <td>@item.CancelledDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@item.CancelledByName</td>
                                    <td class="text-danger">@item.CancelReason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-check-circle display-1 text-success"></i>
                    <h4 class="text-muted mt-3">Нет отменённых процедур за выбранный период</h4>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .stat-card {
        background: white;
        border: 1px solid #e9ecef;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
</style>